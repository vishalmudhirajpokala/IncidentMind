# IncidentMind configuration
#
# Copy to `.env` and fill in only what you have. Every value below is optional.
# With no credentials at all IncidentMind still runs end to end in demo mode:
# the local memory mirror and the deterministic analyst are used, and every
# response is labelled as demo rather than live.
#
# Never commit a real .env. Secrets are read from the environment only.

# --------------------------------------------------------------- application
APP_NAME=IncidentMind
APP_ENV=development          # development | test | production
APP_VERSION=0.1.0
# Demo mode is a *label*, not a stub: it makes the offline path explicit so a
# reviewer is never misled about which providers actually answered.
DEMO_MODE=false

# ------------------------------------------------------------------- database
DATABASE_URL=sqlite:///./incidents.db

# --------------------------------------------------- Hindsight memory (LIVE)
# The external memory service. With these unset, organisational memory is
# served from the local SQLite mirror and results are labelled mode="demo".
HINDSIGHT_BASE_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=incidentmind-demo
HINDSIGHT_API_PREFIX=/api/v1
HINDSIGHT_TIMEOUT_SECONDS=10
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=4000
HINDSIGHT_RETAIN_ASYNC=false

# Provider selection: auto (use Hindsight if configured) | hindsight | local
MEMORY_PROVIDER=auto
MEMORY_RECALL_LIMIT=5

# ------------------------------------------------------------- LLM (Groq LIVE)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_RETRIES=1

# Provider selection: auto (use Groq if configured) | groq | mock
LLM_PROVIDER=auto

# --------------------------------------------------------------------- server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---------------------------------------------------------------------- CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_JSON=true
